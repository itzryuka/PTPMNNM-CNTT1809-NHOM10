# MariaDB chạy chung container với web trên gói miễn phí (512 MB RAM): chỉ nghe nội bộ, bộ nhớ nhỏ
[mysqld]
bind-address            = 127.0.0.1
skip-name-resolve
performance_schema      = OFF
max_connections         = 40
innodb_buffer_pool_size = 32M
key_buffer_size         = 8M
tmp_table_size          = 16M
max_heap_table_size     = 16M
